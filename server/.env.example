# ── Server ──────────────────────────────────────────────────
PORT=5002
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database (Supabase) ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Delivery ─────────────────────────────────────────────────
DELIVERY_FEE=35
FREE_DELIVERY_THRESHOLD=300
RESTAURANT_LAT=13.7563
RESTAURANT_LNG=100.5018
RESTAURANT_ADDRESS="123 Restaurant St, Bangkok"
RESTAURANT_PHONE=+66800000000

# ── Grab Express (optional) ──────────────────────────────────
GRAB_API_URL=https://partner-api.grab.com/grabexpress/v1
GRAB_CLIENT_SECRET=

# ── Lalamove (optional) ──────────────────────────────────────
LALAMOVE_API_URL=https://rest.lalamove.com
LALAMOVE_API_KEY=
